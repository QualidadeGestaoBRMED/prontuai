# =============================================================================
# Front-end (Next.js) — copie para .env.local e preencha.
# Nada aqui com prefixo NEXT_PUBLIC_ é segredo: vai para o bundle do browser.
# =============================================================================

# --- Back-end -----------------------------------------------------------------
# Usada server-side (proxy, NextAuth). Tem precedência sobre NEXT_PUBLIC_API_URL.
BACKEND_API_URL=http://localhost:8010
# Usada pelo browser apenas no upload direto, que não passa pelo proxy.
NEXT_PUBLIC_API_URL=http://localhost:8010

# --- NextAuth -----------------------------------------------------------------
# Obrigatória. Define o prefixo `__Secure-` do cookie de sessão: sem ela, em
# produção, quem escreve e quem lê o cookie podem divergir e nenhuma requisição
# autenticada passa. Ver lib/session-cookie.ts.
NEXTAUTH_URL=http://localhost:3000
# Obrigatória. Segredo forte e próprio do front (não precisa ser o mesmo do back).
NEXTAUTH_SECRET=troque-por-segredo-forte-com-32-ou-mais-caracteres
# Duração do cookie de sessão (segundos). Precisa ser bem MAIOR que
# JWT_EXPIRATION_HOURS do back-end, senão o access token expira junto com o
# cookie e a rotação de refresh nunca acontece.
NEXTAUTH_SESSION_MAX_AGE=28800
# Intervalo de renovação do cookie. Precisa ser MENOR que o maxAge acima.
NEXTAUTH_SESSION_UPDATE_AGE=3600

# --- Google OAuth ---------------------------------------------------------------
# Mesmas credenciais do GOOGLE_CLIENT_ID do back-end (que valida o id_token).
# Sem elas o login com Google não sobe — só o bypass de dev abaixo.
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# --- Desenvolvimento ------------------------------------------------------------
# Login sem Google. Inerte em produção por checagem explícita de NODE_ENV.
# Exige DEV_AUTH_BYPASS=true no back-end também.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
# Role simulada na UI com o bypass ligado: ADMIN | MANAGER | CURATOR | CHECKER | SENDER
NEXT_PUBLIC_DEV_ROLE=ADMIN
