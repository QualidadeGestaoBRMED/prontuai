{
  "uid": "prontuai-metricas",
  "title": "ProntuAI - Aplicação (API / Negócio / Qualidade)",
  "tags": [
    "prontuai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "clinica",
        "label": "Clínica",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(prontuai_documentos_processados_total, clinica_nome)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "API",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Requisições por segundo (por rota)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"prontuai-backend\"}[5m]))",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Latência p95 (por rota)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (http_route, le) (rate(http_server_request_duration_seconds_bucket{job=\"prontuai-backend\"}[5m])))",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Erros 5xx (% das requisições)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{job=\"prontuai-backend\", http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{job=\"prontuai-backend\"}[5m]))",
          "legendFormat": "% 5xx",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Negócio",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Documentos processados por hora",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(prontuai_documentos_processados_total[1h]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Duração do OCR p95 (por motor)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (motor, le) (rate(prontuai_ocr_duracao_segundos_bucket[30m])))",
          "legendFormat": "{{motor}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Textract: timeouts e fallbacks para Docling",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(prontuai_textract_timeout_total[1h]))",
          "legendFormat": "timeouts/h",
          "refId": "A"
        },
        {
          "expr": "sum(increase(prontuai_ocr_fallback_docling_total[1h]))",
          "legendFormat": "fallbacks/h",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "API externa ProntuAI (sucesso x falha)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (resultado) (increase(prontuai_api_consultas_total[1h]))",
          "legendFormat": "{{resultado}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barWidthFactor": 0.8,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Duração do workflow completo (p50 / p95)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(prontuai_workflow_duracao_segundos_bucket[30m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prontuai_workflow_duracao_segundos_bucket[30m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Qualidade da entrega",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Score de confiança do documento (p50 / p10)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(prontuai_confianca_score_bucket[1h])))",
          "legendFormat": "p50 (mediana)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.10, sum by (le) (rate(prontuai_confianca_score_bucket[1h])))",
          "legendFormat": "p10 (piores docs)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Validação automática (IA): aprovados x rejeitados (por hora)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(prontuai_validacao_documentos_total{resultado=\"aprovado\"}[1h]))",
          "legendFormat": "aprovados",
          "refId": "A"
        },
        {
          "expr": "sum(increase(prontuai_validacao_documentos_total{resultado=\"rejeitado\"}[1h]))",
          "legendFormat": "rejeitados",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barWidthFactor": 0.8,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Revisão humana: aprovados x rejeitados (por hora)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(prontuai_revisao_humana_total{decisao=\"aprovado\"}[1h]))",
          "legendFormat": "aprovados",
          "refId": "A"
        },
        {
          "expr": "sum(increase(prontuai_revisao_humana_total{decisao=\"rejeitado\"}[1h]))",
          "legendFormat": "rejeitados",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Taxa de rejeição humana (%) — última 24h",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * sum(increase(prontuai_revisao_humana_total{decisao=\"rejeitado\"}[24h])) / clamp_min(sum(increase(prontuai_revisao_humana_total[24h])), 1)",
          "legendFormat": "% rejeitados",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Por Clínica",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "collapsed": false
    },
    {
      "type": "barchart",
      "title": "Documentos processados por clínica (24h)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (clinica_nome) (increase(prontuai_documentos_processados_total{clinica_nome=~\"$clinica\"}[24h]))",
          "legendFormat": "{{clinica_nome}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "barchart",
      "title": "Taxa de erro por clínica (24h)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * sum by (clinica_nome) (increase(prontuai_documentos_processados_total{status=~\"error|exception\", clinica_nome=~\"$clinica\"}[24h])) / clamp_min(sum by (clinica_nome) (increase(prontuai_documentos_processados_total{clinica_nome=~\"$clinica\"}[24h])), 1)",
          "legendFormat": "{{clinica_nome}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e66767"
          },
          "custom": {
            "axisSoftMin": 0
          },
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "barchart",
      "title": "Score de confiança médio por clínica (24h)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (clinica_nome) (increase(prontuai_confianca_score_sum{clinica_nome=~\"$clinica\"}[24h])) / clamp_min(sum by (clinica_nome) (increase(prontuai_confianca_score_count{clinica_nome=~\"$clinica\"}[24h])), 1)",
          "legendFormat": "{{clinica_nome}}",
