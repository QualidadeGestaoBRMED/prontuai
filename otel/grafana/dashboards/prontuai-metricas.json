        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Latência das chamadas HTTP de saída p95 (por destino)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (server_address, le) (rate(http_client_request_duration_seconds_bucket{job=\"prontuai-backend\"}[5m])))",
          "legendFormat": "{{server_address}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "p95 das chamadas HTTP que o backend faz para fora (API ProntuAI via httpx). Vem da instrumentação OpenTelemetry do httpx, não de código de métrica no app. server_address é o host de destino — cardinalidade baixa, o caminho da URL não entra como rótulo."
    },
    {
