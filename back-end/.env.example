# OpenAI Configuration
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BRMED System Credentials
BRMED_USERNAME=seu_usuario
BRMED_PASSWORD=sua_senha

# Banco de dados (Postgres na mesma VPS, container prontuai-db)
# Nome do serviço/host é "db" só no compose de staging local; em produção o
# Postgres sobe via docker-compose.db.yml, numa pasta PRÓPRIA e SEPARADA do
# backend (/home/ec2-user/prontuai-db, com seu próprio .env — nem o compose
# nem o .env são compartilhados com o backend, de propósito, ver
# ops/deploy/aws-vps-ghcr.md). Em produção estas variáveis daqui pra baixo
# até "fim Postgres/backup" NÃO vão no .env do backend
# (/home/ec2-user/prontuai/.env) — vão em /home/ec2-user/prontuai-db/.env.
# A única que fica no .env do backend é a DATABASE_URL logo abaixo, com o
# mesmo usuário/senha/banco escritos nos dois arquivos (eles não se leem
# automaticamente um ao outro).
POSTGRES_USER=prontuai
POSTGRES_PASSWORD=troque-por-senha-forte-gerada-com-32-ou-mais-caracteres
POSTGRES_DB=prontuai
# Bind de teste em loopback pra acesso via túnel SSH (docker-compose.db.yml).
# Nunca mude para 0.0.0.0; remova esse mapeamento de porta quando não precisar mais.
DB_BIND_ADDRESS=127.0.0.1
DB_HOST_PORT=5432

# Backup do Postgres (/home/ec2-user/prontuai-db/script/backup_postgres.sh +
# systemd timer). Vai no .env do banco (/home/ec2-user/prontuai-db/.env),
# não no .env do backend. Compatível com AWS S3 ou Cloudflare R2 (mesma API
# S3) — só muda endpoint/creds. Use credenciais dedicadas a este bucket,
# nunca as chaves AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY do Textract acima
# (provedor/escopo diferentes).
BACKUP_S3_BUCKET=nome-do-bucket-de-backup
BACKUP_S3_PREFIX=postgres-backups/prontuai
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# AWS S3: deixe vazio (usa o endpoint padrão da AWS)
BACKUP_S3_ENDPOINT_URL=
# R2 ignora região real, mas o aws-cli exige um valor: use "auto" no R2,
# ou a região do bucket (ex.: us-east-1) na AWS S3.
BACKUP_S3_REGION=auto
# AES256 na AWS S3; deixe vazio no R2 (já criptografa em repouso por padrão).
BACKUP_S3_SSE=
BACKUP_S3_ACCESS_KEY_ID=access-key-do-bucket-de-backup
BACKUP_S3_SECRET_ACCESS_KEY=secret-key-do-bucket-de-backup
BACKUP_RETENTION_DAYS=35
# fim Postgres/backup (variáveis acima vão no .env do banco em produção)

# .env do BACKEND (/home/ec2-user/prontuai/.env): aponta pro serviço
# "prontuai-db" da rede Docker, com o mesmo usuário/senha/banco de cima.
DATABASE_URL=postgresql://prontuai:troque-por-senha-forte-gerada-com-32-ou-mais-caracteres@prontuai-db:5432/prontuai

# ProntuAI API (patients_exams)
PRONTUAI_API_BASE_URL=https://api.grupobrmed.com.br
PRONTUAI_SERVICE_TOKEN=seu_service_token
PRONTUAI_CLIENT_NAME=seu_client_name
PRONTUAI_API_TIMEOUT_SECONDS=20
USE_PRONTUAI_PATIENTS_EXAMS=false

# AWS Textract Configuration (opcional - para OCR alternativo)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=nome-do-bucket

# Feature Toggle: use "true" para ativar Textract, "false" para usar Docling (padrão)
USE_TEXTRACT=false

# Textract síncrono por página: reduz falhas temporárias em PDFs com muitas páginas
TEXTRACT_SYNC_PAGE_RETRY_MAX=2
TEXTRACT_SYNC_PAGE_DELAY_SECONDS=0.35
TEXTRACT_SYNC_RETRY_BASE_DELAY_SECONDS=0.8

# Configurações opcionais do modelo
MODELO_GPT=gpt-4o-mini
MODELO_EMBEDDING=text-embedding-3-large
K_VIZINHOS_FAQ=2
MAX_DISTANCIA_FAQ=1.0

# Número de workers do Gunicorn (padrão: 4)
WORKERS=4

# Auth/JWT hardening
APP_ENV=local
GOOGLE_CLIENT_ID=seu_google_client_id
# Obrigatório fora de ambiente local/teste.
JWT_SECRET_KEY=troque-por-segredo-forte-com-32-ou-mais-caracteres
JWT_EXPIRATION_HOURS=2
JWT_ISSUER=prontuai-backend
JWT_AUDIENCE=prontuai-frontend
JWT_MIN_SECRET_LENGTH=32
DEV_AUTH_BYPASS=false
JWT_SECRET_KEY_LOCAL_FALLBACK=opcional-apenas-local

# Rate limit / hardening de borda
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_MINUTE=180
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_RECON_PER_MINUTE=5
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.19.0.2

# Assinatura de artefatos RAG (exam_similarity)
ARTIFACT_SIGNING_KEY=troque-por-chave-forte-de-assinatura

# Observabilidade (ver ops/observability/README.md)
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
# Métricas Prometheus em /metrics (bloquear a rota no nginx público)
METRICS_ENABLED=true
# Erros/exceções no Sentry (opcional)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
