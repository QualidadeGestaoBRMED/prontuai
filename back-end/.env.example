# OpenAI Configuration
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BRMED System Credentials
BRMED_USERNAME=seu_usuario
BRMED_PASSWORD=sua_senha

# ProntuAI API (patients_exams)
PRONTUAI_API_BASE_URL=https://api.grupobrmed.com.br
PRONTUAI_SERVICE_TOKEN=seu_service_token
PRONTUAI_CLIENT_NAME=seu_client_name
PRONTUAI_API_TIMEOUT_SECONDS=20
USE_PRONTUAI_PATIENTS_EXAMS=false
USE_PRONTUAI_API_FALLBACK_RPA=true

# AWS Textract Configuration (opcional - para OCR alternativo)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=nome-do-bucket

# Feature Toggle: use "true" para ativar Textract, "false" para usar Docling (padrão)
USE_TEXTRACT=false

# Textract síncrono por página: reduz falhas temporárias em PDFs com muitas páginas
TEXTRACT_SYNC_PAGE_RETRY_MAX=2
TEXTRACT_SYNC_PAGE_DELAY_SECONDS=0.35
TEXTRACT_SYNC_RETRY_BASE_DELAY_SECONDS=0.8

# Configurações opcionais do modelo
MODELO_GPT=gpt-4o-mini
MODELO_EMBEDDING=text-embedding-3-large
K_VIZINHOS_FAQ=2
MAX_DISTANCIA_FAQ=1.0

# Número de workers do Gunicorn (padrão: 4)
WORKERS=4

# Auth/JWT hardening
APP_ENV=local
GOOGLE_CLIENT_ID=seu_google_client_id
# Obrigatório fora de ambiente local/teste.
JWT_SECRET_KEY=troque-por-segredo-forte-com-32-ou-mais-caracteres
JWT_EXPIRATION_HOURS=2
JWT_ISSUER=prontuai-backend
JWT_AUDIENCE=prontuai-frontend
JWT_MIN_SECRET_LENGTH=32
DEV_AUTH_BYPASS=false
JWT_SECRET_KEY_LOCAL_FALLBACK=opcional-apenas-local

# Rate limit / hardening de borda
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_MINUTE=180
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_RECON_PER_MINUTE=5
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.19.0.2

# Assinatura de artefatos RAG (exam_similarity)
ARTIFACT_SIGNING_KEY=troque-por-chave-forte-de-assinatura
