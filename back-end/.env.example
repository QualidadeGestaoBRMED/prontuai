# OpenAI Configuration
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BRMED System Credentials
BRMED_USERNAME=seu_usuario
BRMED_PASSWORD=sua_senha

# Banco de dados (Postgres na mesma VPS, container prontuai-db)
# Nome do serviço/host é "db" só no compose de staging local; em produção o
# Postgres sobe via docker-compose.db.yml, numa pasta PRÓPRIA e SEPARADA do
# backend (/home/ec2-user/prontuai-db, com seu próprio .env — nem o compose
# nem o .env são compartilhados com o backend, de propósito, ver
# ops/deploy/aws-vps-ghcr.md). Em produção estas variáveis daqui pra baixo
# até "fim Postgres/backup" NÃO vão no .env do backend
# (/home/ec2-user/prontuai/.env) — vão em /home/ec2-user/prontuai-db/.env.
# A única que fica no .env do backend é a DATABASE_URL logo abaixo, com o
# mesmo usuário/senha/banco escritos nos dois arquivos (eles não se leem
# automaticamente um ao outro).
POSTGRES_USER=prontuai
POSTGRES_PASSWORD=troque-por-senha-forte-gerada-com-32-ou-mais-caracteres
POSTGRES_DB=prontuai
# Bind de teste em loopback pra acesso via túnel SSH (docker-compose.db.yml).
# Nunca mude para 0.0.0.0; remova esse mapeamento de porta quando não precisar mais.
DB_BIND_ADDRESS=127.0.0.1
DB_HOST_PORT=5432

# Backup do Postgres (/home/ec2-user/prontuai-db/script/backup_postgres.sh +
# systemd timer). Vai no .env do banco (/home/ec2-user/prontuai-db/.env),
# não no .env do backend. Compatível com AWS S3 ou Cloudflare R2 (mesma API
# S3) — só muda endpoint/creds. Use credenciais dedicadas a este bucket,
# nunca as chaves AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY do Textract acima
# (provedor/escopo diferentes).
BACKUP_S3_BUCKET=nome-do-bucket-de-backup
BACKUP_S3_PREFIX=postgres-backups/prontuai
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# AWS S3: deixe vazio (usa o endpoint padrão da AWS)
BACKUP_S3_ENDPOINT_URL=
# R2 ignora região real, mas o aws-cli exige um valor: use "auto" no R2,
# ou a região do bucket (ex.: us-east-1) na AWS S3.
BACKUP_S3_REGION=auto
# AES256 na AWS S3; deixe vazio no R2 (já criptografa em repouso por padrão).
BACKUP_S3_SSE=
BACKUP_S3_ACCESS_KEY_ID=access-key-do-bucket-de-backup
BACKUP_S3_SECRET_ACCESS_KEY=secret-key-do-bucket-de-backup
BACKUP_RETENTION_DAYS=35
# fim Postgres/backup (variáveis acima vão no .env do banco em produção)

# .env do BACKEND (/home/ec2-user/prontuai/.env): aponta pro serviço
# "prontuai-db" da rede Docker, com o mesmo usuário/senha/banco de cima.
DATABASE_URL=postgresql://prontuai:troque-por-senha-forte-gerada-com-32-ou-mais-caracteres@prontuai-db:5432/prontuai

# ProntuAI API (patients_exams)
PRONTUAI_API_BASE_URL=https://api.grupobrmed.com.br
PRONTUAI_SERVICE_TOKEN=seu_service_token
PRONTUAI_CLIENT_NAME=seu_client_name
PRONTUAI_API_TIMEOUT_SECONDS=20
USE_PRONTUAI_PATIENTS_EXAMS=false

# AWS Textract Configuration (opcional - para OCR alternativo)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=nome-do-bucket

# Feature Toggle: use "true" para ativar Textract, "false" para usar Docling (padrão)
USE_TEXTRACT=false

# Textract síncrono por página: reduz falhas temporárias em PDFs com muitas páginas
TEXTRACT_SYNC_PAGE_RETRY_MAX=2
TEXTRACT_SYNC_PAGE_DELAY_SECONDS=0.35
TEXTRACT_SYNC_RETRY_BASE_DELAY_SECONDS=0.8

# Configurações opcionais do modelo
MODELO_GPT=gpt-4o-mini
MODELO_EMBEDDING=text-embedding-3-large
K_VIZINHOS_FAQ=2
MAX_DISTANCIA_FAQ=1.0

# Número de workers do Gunicorn (padrão: 4)
WORKERS=4

# Auth/JWT hardening
APP_ENV=local
GOOGLE_CLIENT_ID=seu_google_client_id
# Obrigatório fora de ambiente local/teste.
JWT_SECRET_KEY=troque-por-segredo-forte-com-32-ou-mais-caracteres
JWT_EXPIRATION_HOURS=2
JWT_ISSUER=prontuai-backend
JWT_AUDIENCE=prontuai-frontend
JWT_MIN_SECRET_LENGTH=32
DEV_AUTH_BYPASS=false
JWT_SECRET_KEY_LOCAL_FALLBACK=opcional-apenas-local

# Rate limit / hardening de borda
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_MINUTE=180
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_RECON_PER_MINUTE=5
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.19.0.2

# Assinatura de artefatos RAG (exam_similarity)
ARTIFACT_SIGNING_KEY=troque-por-chave-forte-de-assinatura

# Observabilidade (ver ops/observability/README.md)
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
# Rotacao do arquivo de log local. Ele deixou de ser lido por promtail (os logs
# vao por OTLP), mas continua sendo a fonte operacional e os logs de crash —
# e antes disto crescia sem limite (o app.log local chegou a dezenas de MB).
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=5
# --- OpenTelemetry ---------------------------------------------------------
# Toda a telemetria (metricas, traces e logs) sai por um unico canal OTLP
# autenticado para o otel-collector da VPS Oracle, onde ficam Tempo, Loki,
# Prometheus e o Grafana. O backend nao expoe /metrics e nada nesta maquina le
# os logs.

# Identidade. service.name vira o rotulo job= das series no Prometheus E o
# label job= dos streams no Loki, entao mudar quebra paineis e alertas.
#
# service.namespace fica DE FORA de proposito: o exporter Prometheus do coletor
# monta o rotulo job como "<namespace>/<name>", entao definir namespace viraria
# job="brmed/prontuai-backend" e nenhum painel encontraria as series. Os demais
# atributos de resource nao afetam job — vao para a metrica sintetica
# target_info.
OTEL_SERVICE_NAME=prontuai-backend
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production,service.version=2.0.0

# Destino: o coletor da Oracle. gRPC na 4317 (o padrao dos outros projetos).
#
# O esquema TEM que ser https:// — é ele que faz o exportador abrir canal com
# TLS. Com http:// o SDK usa canal em claro, e a telemetria atravessa a internet
# publica sem criptografia: os LogRecords levam e-mail do usuario e ha CPF em
# linha de log, e o proprio token abaixo viajaria capturavel e reutilizavel.
# Autenticar o coletor nao protege de quem esta no caminho.
#
# Com certificado de CA publica (Let's Encrypt) nao precisa de mais nada — o SDK
# valida pelas raizes do sistema. Para CA interna, aponte o PEM em
# OTEL_EXPORTER_OTLP_CERTIFICATE.
#
# O token é o mesmo OTEL_AUTH_TOKEN configurado no coletor de lá; note o %20,
# que é o espaco depois de "Bearer" — sem o URL-encoding o header sai quebrado
# e o coletor responde 401.
OTEL_EXPORTER_OTLP_ENDPOINT=https://obs.exemplo.com:4317
# OTEL_EXPORTER_OTLP_CERTIFICATE=/etc/ssl/certs/ca-interna.pem
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<token>
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_TIMEOUT=10000

# Os tres sinais ligados: Tempo, Prometheus e Loki existem na Oracle.
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Sampling das traces (metricas e logs nunca sao amostrados). always_on é a
# recomendacao de fase 1 e garante que todo trace_id que aparece num log
# corresponda a uma trace que existe no Tempo — com 10%, 90% dos links do
# Grafana morreriam.
OTEL_TRACES_SAMPLER=parentbased_always_on

# Correlacao de logs: injeta trace_id/span_id em cada linha dentro de uma
# requisicao, ao lado do request_id. É o que liga log a trace no Grafana.
# ATENCAO: o backend passa set_logging_format=False ao instrumentor de
# proposito — sem isso ele chamaria logging.basicConfig e destruiria o formato
# JSON do arquivo local.
OTEL_PYTHON_LOG_CORRELATION=true

# Nivel dos logs que vao PELA REDE, independente do arquivo local. Este é o
# botao para cortar volume sem perder detalhe no disco: OTEL_LOG_LEVEL=WARNING
# manda so warning/error para a Oracle e mantem INFO em app.log. Cuidado: o
# dashboard de exploracao filtra linhas INFO (request.completed,
# workflow_completed), que sumiriam.
OTEL_LOG_LEVEL=INFO

# Batching. O intervalo de metricas casa com o scrape_interval do Prometheus da
# Oracle; o default do OTel (60s) faria o Prometheus coletar 4x o mesmo valor.
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512

# Limites contra explosao de dados
OTEL_ATTRIBUTE_COUNT_LIMIT=128
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=4096
OTEL_SPAN_EVENT_COUNT_LIMIT=128

# Rotas fora da instrumentacao: o healthcheck do container bate /health a cada
# 30s e viraria a rota mais movimentada do painel.
OTEL_PYTHON_EXCLUDED_URLS=health,healthz,readyz,livez,metrics

# Kill switch: true desliga toda a telemetria sem redeploy de codigo.
OTEL_SDK_DISABLED=false
# Erros/exceções no Sentry (opcional)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
