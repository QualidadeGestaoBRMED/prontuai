# Logging
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_LEVEL=INFO

# --- OpenTelemetry ---------------------------------------------------------
# O backend não expõe mais /metrics: empurra métricas (e traces, se ligadas)
# por OTLP para o otel-collector, que as republica em :8889/metrics para o
# Prometheus. Variáveis padrão do OTel — nenhuma é específica do ProntuAI.

# Identidade. service.name vira o rótulo job= das séries no Prometheus, então
# mudá-lo quebra os seletores dos painéis.
#
# service.namespace fica DE FORA de propósito: o exporter Prometheus do
# collector monta o rótulo job como "<namespace>/<name>", então definir
# namespace=brmed viraria job="brmed/prontuai-backend" e nenhum painel ou
# alerta encontraria as séries. (No caminho OTLP-nativo do Prometheus 3.x,
# namespace viraria um label próprio via promote_resource_attributes — mas
# esta stack usa scrape, não OTLP direto no Prometheus.) Os demais atributos
# de resource não afetam job: vão para a métrica sintética target_info.
OTEL_SERVICE_NAME=prontuai-backend
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production,service.version=2.0.0

# Destino: endpoint BASE, SEM /v1/metrics (o SDK completa o caminho sozinho).
# Já as variáveis por sinal (OTEL_EXPORTER_OTLP_METRICS_ENDPOINT) exigem o
# caminho completo — misturar as duas formas dá 404 silencioso.
# "otel-collector" só resolve se o backend estiver na mesma rede docker da
# stack de observabilidade; rodando direto no host, use http://127.0.0.1:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_TIMEOUT=10000

# Sinais ligados. traces=none enquanto não houver Tempo/Jaeger na stack: o
# collector hoje as descartaria, e serializar span em Python disputa o GIL com
# a aplicação. logs=none porque os logs vão para o Loki via promtail lendo o
# arquivo, não por OTLP.
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Sampling das traces (métricas nunca são amostradas). always_on é a
# recomendação de fase 1: como as traces não são exportadas hoje, o custo é só
# o span em memória — e cada trace_id que aparece nos logs continua válido no
# dia em que um Tempo entrar na stack. Com amostragem de 10%, 90% dos trace_id
# logados virariam link morto.
OTEL_TRACES_SAMPLER=parentbased_always_on

# Correlação de logs: injeta trace_id/span_id em cada linha de log dentro de
# uma requisição, ao lado do request_id que já existia. É o que permite pular
# de um trace para as linhas de log daquela requisição no Grafana.
# ATENÇÃO: o backend passa set_logging_format=False ao instrumentor de
# propósito — sem isso ele chamaria logging.basicConfig e destruiria o formato
# JSON que o promtail/Loki consomem.
OTEL_PYTHON_LOG_CORRELATION=true

# Batching. O intervalo de métricas casa com o scrape_interval do Prometheus;
# o default do OTel (60s) faria o Prometheus coletar 4x o mesmo valor.
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512

# Limites contra explosão de dados
OTEL_ATTRIBUTE_COUNT_LIMIT=128
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=4096
OTEL_SPAN_EVENT_COUNT_LIMIT=128

# Rotas fora da instrumentação: o healthcheck do container bate /health a cada
# 30s e viraria a rota mais movimentada do painel.
OTEL_PYTHON_EXCLUDED_URLS=health,healthz,readyz,livez,metrics

# Kill switch: true desliga toda a telemetria sem redeploy de código. Tenha
# isso mapeado como variável de deploy desde o dia 1.
OTEL_SDK_DISABLED=false

# Audit
AUDIT_LOG_ENABLED=true
AUDIT_LOG_ALL_REQUESTS=false

# Concurrency
OCR_CONCURRENCY=2
DOCUMENT_PROCESS_CONCURRENCY=2
