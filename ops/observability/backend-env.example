# Logging
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
# Rotacao do arquivo de log local. Ele deixou de ser lido por promtail (os logs
# vao por OTLP), mas continua sendo a fonte operacional e os logs de crash —
# e antes disto crescia sem limite (o app.log local chegou a dezenas de MB).
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=5

# --- OpenTelemetry ---------------------------------------------------------
# Toda a telemetria (metricas, traces e logs) sai por um unico canal OTLP
# autenticado para o otel-collector da VPS Oracle, onde ficam Tempo, Loki,
# Prometheus e o Grafana. O backend nao expoe /metrics e nada nesta maquina le
# os logs.

# Identidade. service.name vira o rotulo job= das series no Prometheus E o
# label job= dos streams no Loki, entao mudar quebra paineis e alertas.
#
# service.namespace fica DE FORA de proposito: o exporter Prometheus do coletor
# monta o rotulo job como "<namespace>/<name>", entao definir namespace viraria
# job="brmed/prontuai-backend" e nenhum painel encontraria as series. Os demais
# atributos de resource nao afetam job — vao para a metrica sintetica
# target_info.
OTEL_SERVICE_NAME=prontuai-backend
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production,service.version=2.0.0

# Destino: o coletor da Oracle. gRPC na 4317 (o padrao dos outros projetos).
# O token é o mesmo OTEL_AUTH_TOKEN configurado no coletor de lá; note o %20,
# que é o espaco depois de "Bearer" — sem o URL-encoding o header sai quebrado
# e o coletor responde 401.
OTEL_EXPORTER_OTLP_ENDPOINT=http://obs.exemplo.com:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<token>
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_TIMEOUT=10000

# Os tres sinais ligados: Tempo, Prometheus e Loki existem na Oracle.
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Sampling das traces (metricas e logs nunca sao amostrados). always_on é a
# recomendacao de fase 1 e garante que todo trace_id que aparece num log
# corresponda a uma trace que existe no Tempo — com 10%, 90% dos links do
# Grafana morreriam.
OTEL_TRACES_SAMPLER=parentbased_always_on

# Correlacao de logs: injeta trace_id/span_id em cada linha dentro de uma
# requisicao, ao lado do request_id. É o que liga log a trace no Grafana.
# ATENCAO: o backend passa set_logging_format=False ao instrumentor de
# proposito — sem isso ele chamaria logging.basicConfig e destruiria o formato
# JSON do arquivo local.
OTEL_PYTHON_LOG_CORRELATION=true

# Nivel dos logs que vao PELA REDE, independente do arquivo local. Este é o
# botao para cortar volume sem perder detalhe no disco: OTEL_LOG_LEVEL=WARNING
# manda so warning/error para a Oracle e mantem INFO em app.log. Cuidado: o
# dashboard de exploracao filtra linhas INFO (request.completed,
# workflow_completed), que sumiriam.
OTEL_LOG_LEVEL=INFO

# Batching. O intervalo de metricas casa com o scrape_interval do Prometheus da
# Oracle; o default do OTel (60s) faria o Prometheus coletar 4x o mesmo valor.
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512

# Limites contra explosao de dados
OTEL_ATTRIBUTE_COUNT_LIMIT=128
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=4096
OTEL_SPAN_EVENT_COUNT_LIMIT=128

# Rotas fora da instrumentacao: o healthcheck do container bate /health a cada
# 30s e viraria a rota mais movimentada do painel.
OTEL_PYTHON_EXCLUDED_URLS=health,healthz,readyz,livez,metrics

# Kill switch: true desliga toda a telemetria sem redeploy de codigo.
OTEL_SDK_DISABLED=false

# Audit
AUDIT_LOG_ENABLED=true
AUDIT_LOG_ALL_REQUESTS=false

# Concurrency
OCR_CONCURRENCY=2
DOCUMENT_PROCESS_CONCURRENCY=2
