{
  "uid": "prontuai-logs",
  "title": "ProntuAI - Logs",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "user_email",
        "label": "E-mail do usuário",
        "type": "textbox",
        "hide": 0,
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "options": [],
        "description": "Regex sobre o campo JSON (ex.: .*maria.* ou valor exato). Use .* para todos."
      },
      {
        "name": "cpf",
        "label": "CPF",
        "type": "textbox",
        "hide": 0,
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "options": [],
        "description": "Regex sobre o campo JSON (ex.: .*maria.* ou valor exato). Use .* para todos."
      },
      {
        "name": "document_id",
        "label": "Documento",
        "type": "textbox",
        "hide": 0,
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "options": [],
        "description": "Regex sobre o campo JSON (ex.: .*maria.* ou valor exato). Use .* para todos."
      },
      {
        "name": "request_id",
        "type": "textbox",
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "description": "Regex sobre o campo JSON (ex.: .*maria.* ou valor exato). Use .* para todos."
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests (req/s - 5m)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=\"prontuai-backend\"} |= \"request.completed\" [5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "type": "stat",
      "title": "Errors (req/s - 5m)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=\"prontuai-backend\", level=\"ERROR\"}[5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "type": "stat",
      "title": "External API failures (req/s - 5m)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=\"prontuai-backend\"} |= \"brmed_failed\" [5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "type": "logs",
      "title": "Logs (filtrados)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"prontuai-backend\"} | json | user_email=~\"$user_email\" | cpf=~\"$cpf\" | document_id=~\"$document_id\" | request_id=~\"$request_id\" | line_format \"{{.message}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "type": "logs",
      "title": "Logs (raw)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"prontuai-backend\"} | json | line_format \"{{.message}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    }
  ]
}