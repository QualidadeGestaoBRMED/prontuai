{
  "uid": "prontuai-logs",
  "title": "ProntuAI - Logs",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "user_email",
        "label": "E-mail do usuário",
        "type": "textbox",
        "hide": 0,
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "options": [],
        "description": "Regex sobre o campo JSON (ex.: .*maria.* ou valor exato). Use .* para todos."
      },
      {
        "name": "cpf",
        "label": "CPF",
        "type": "textbox",
        "hide": 0,
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "options": [],
        "description": "Regex sobre o campo JSON (ex.: .*maria.* ou valor exato). Use .* para todos."
      },
      {
        "name": "document_id",
        "label": "Documento",
        "type": "textbox",
        "hide": 0,
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "options": [],
        "description": "Regex sobre o campo JSON (ex.: .*maria.* ou valor exato). Use .* para todos."
      },
      {
        "name": "request_id",
        "type": "textbox",
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "description": "Regex sobre o campo JSON (ex.: .*maria.* ou valor exato). Use .* para todos."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Atividade",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Usuários ativos (24h)",
      "description": "Usuários distintos com pelo menos uma requisição autenticada nas últimas 24h.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "count(count by (user_email) (count_over_time({job=\"prontuai-backend\"} | json | user_email!=\"\" [24h])))",
          "legendFormat": "usuários ativos",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Requests (req/s - 5m)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=\"prontuai-backend\"} |= \"request.completed\" [5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "type": "stat",
      "title": "Errors (req/s - 5m)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=\"prontuai-backend\", level=\"ERROR\"}[5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "type": "stat",
      "title": "External API failures (req/s - 5m)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=\"prontuai-backend\"} |= \"brmed_failed\" [5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "type": "logs",
      "title": "Logs (filtrados)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"prontuai-backend\"} | json | user_email=~\"$user_email\" | cpf=~\"$cpf\" | document_id=~\"$document_id\" | request_id=~\"$request_id\" | line_format \"{{.message}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "type": "logs",
      "title": "Logs (raw)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"prontuai-backend\"} | json | line_format \"{{.message}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "type": "row",
      "title": "Por Usuário",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "collapsed": false
    },
    {
      "type": "barchart",
      "title": "Documentos processados por usuário (24h)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "topk(15, sum by (user_email) (count_over_time({job=\"prontuai-backend\"} |= \"workflow_completed\" | json [24h])))",
          "legendFormat": "{{user_email}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "barchart",
      "title": "Falhas de processamento por usuário (24h)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "topk(15, sum by (user_email) (count_over_time({job=\"prontuai-backend\"} |= \"workflow_failed\" | json [24h])))",
          "legendFormat": "{{user_email}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e66767"
          }
        },
        "overrides": []
      }
    }
  ]
}